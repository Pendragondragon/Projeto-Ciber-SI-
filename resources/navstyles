/* Reset & Base Styles */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html, body {
    height: 100%;
    font-family: 'Inter', sans-serif, system-ui;
    background-color: #111827; /* Gray-900 */
    color: #d1d5db; /* Gray-300 */
}

/* Navbar Container */
.navbar {
    position: relative;
    background-color: rgba(31, 41, 55, 0.5); /* Gray-800/50 */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
}

.nav-wrapper {
    display: flex;
    height: 4rem;
    align-items: center;
    justify-content: space-between;
}

/* Navigation Links */
.nav-main {
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.logo img {
    height: 2.5rem;
    width: auto;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 1rem;
}

/* Hide desktop links on small screens */
@media (max-width: 640px) {
    .nav-links { display: none; }
}

.nav-item {
    text-decoration: none;
    color: #d1d5db;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    transition: all 0.2s;
}

.nav-item:hover {
    background-color: rgba(3, 7, 18, 0.5); /* Gray-950/50 */
    color: #ffffff;
}

/* Icons & Actions */
.nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.notif-btn, .menu-button {
    background: none;
    border: none;
    color: #9ca3af;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 9999px;
}

.notif-btn:hover { color: #ffffff; }

.icon-bell, .icon-open {
    width: 1.5rem;
    height: 1.5rem;
}

/* Profile Dropdown */
.profile-dropdown {
    position: relative;
}

.profile-btn {
    background: none;
    border: none;
    cursor: pointer;
}

.avatar-placeholder {
    width: 2rem;
    height: 2rem;
    background-color: #4b5563;
    border-radius: 9999px;
}

.dropdown-menu {
    display: none; /* Toggle with JS */
    position: absolute;
    right: 0;
    top: 2.5rem;
    width: 12rem;
    background-color: #1f2937;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.375rem;
    padding: 0.25rem 0;
    z-index: 50;
}

.dropdown-menu a {
    display: block;
    padding: 0.5rem 1rem;
    color: #d1d5db;
    text-decoration: none;
    font-size: 0.875rem;
}

.dropdown-menu a:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.user-link {
    background-color: transparent; 
    color: #d1d5db;
    cursor: pointer;
    padding: 0.75rem;
    width: 100%;
    text-align: left;
    border: none;
    transition: 0.3s;
    display: block;
}

.user-link:hover, .user-link.active {
    background-color: rgba(255, 255, 255, 0.05);
    color: #fff;
}

.panel {
    padding: 0 1rem;
    background-color: rgba(0, 0, 0, 0.2); /* Darker sub-menu */
    display: none;
    overflow: hidden;
    border-radius: 0.375rem;
    margin-top: 0.5rem;
}

.panel p a {
    padding: 0.5rem 0;
    font-size: 0.875rem;
    color: #9ca3af;
    display: block;
    text-decoration: none;
}

.panel p a:hover {
    color: #fff;
}

/* Ensure mobile menu actually shows when not hidden */
.mobile-nav-content:not([hidden]) {
    display: block;
    background-color: #1f2937;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}


/* Mobile Specifics */
.mobile-menu-toggle {
    display: none;
}

@media (max-width: 640px) {
    .mobile-menu-toggle { display: block; }
    .mobile-nav-content {
        padding: 0.5rem 0.5rem 0.75rem;
    }
    .mobile-nav-content a {
        display: block;
        padding: 0.5rem 0.75rem;
        color: #d1d5db;
        text-decoration: none;
        border-radius: 0.375rem;
    }
}
